import urllib.request, json, base64, sys

results = []
s = 0

def t(name, url, method="GET", data=None, headers=None, auth=None):
    global s
    try:
        req = urllib.request.Request(url, method=method)
        if headers:
            for k, v in headers.items():
                req.add_header(k, v)
        if data:
            req.add_header("Content-Type", "application/json")
            req.data = json.dumps(data).encode()
        if auth:
            enc = base64.b64encode(f"{auth[0]}:{auth[1]}".encode()).decode()
            req.add_header("Authorization", f"Basic {enc}")
        
        resp = urllib.request.urlopen(req, timeout=10)
        body = resp.read().decode()
        s += 1
        results.append((s, name, resp.status, "OK"))
        print(f"  [{resp.status}] {name}")
        if body:
            print(f"    {body[:160].replace(chr(10),' ')}")
        return body
    except urllib.error.HTTPError as e:
        body = e.read().decode()[:200]
        s += 1
        ok = "OK" if ("expect 403" in name.lower() and e.code == 403) else "FAIL"
        results.append((s, name, e.code, ok))
        print(f"  [{e.code}] {name} - {ok}")
        if body.strip():
            print(f"    {body[:160]}")
        return body
    except Exception as e:
        s += 1
        results.append((s, name, 0, "ERROR"))
        print(f"  [ERR] {name} - {e}")
        return None

